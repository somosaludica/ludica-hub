# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis na Vercel.
# Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Só na Vercel (servidor). Nunca com NEXT_PUBLIC_, nunca no repositório, nunca no chat.
# Supabase > Project Settings > API Keys > Secret key. Usada para convidar pessoas.
SUPABASE_SECRET_KEY=
